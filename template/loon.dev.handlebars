[Script]
# 🗺️ Network Defaults
http-request ^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults script-path=https://gist.githubusercontent.com/VirgilClyne/b7524906119fa250bc933cc9a08e939a/raw/request.dev.bundle.js, tag=🗺️ Maps.config.defaults.request, argument={{{scriptParams}}}
